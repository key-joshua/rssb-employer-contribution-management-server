PORT=3000
PAGE_SIZE=10
PAGE_MAX=100
PAGE_NUMBER=1
RATE_LIMIT_MAX=5
JWT_EXPIRES_IN=1h
RATE_LIMIT_TTL=6000
NODE_ENV=development
JWT_SECRET_KEY=SUPER_SECRET_KEY
SERVER_URL=http://localhost:3000
APP_NAME=RSSB EMPLOYER CONTRIBUTION MANAGEMENT SERVER

SWAGGER_API_VERSION=1.0
SWAGGER_API_TITLE=RSSB Employer Contribution Management Server API
SWAGGER_API_DESCRIPTION=This API provides endpoints for managing employer contribution declarations, employee salary records, and contribution calculations. It enables employers to create, submit, validate, and track monthly contribution declarations.

DB_POSTGRESQL_PORT=5432
DB_POSTGRESQL_DATABASE=rssb
DB_POSTGRESQL_HOST=localhost
DB_POSTGRESQL_USERNAME=postgres
DB_POSTGRESQL_PASSWORD=your-database-password-here
